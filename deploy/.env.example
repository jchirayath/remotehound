# RemoteHound bundle configuration. Copy to .env and fill in the REQUIRED values.
#   cp .env.example .env && docker run --rm ghcr.io/jchirayath/remotehound gen-secret >> .env
# Every variable is documented in docs/CONFIG.md (generated by `remotehound config-doc`).
# .env holds secrets: keep it out of git (it is in .gitignore) and readable only by root (chmod 600).

# ---- REQUIRED --------------------------------------------------------------
RH_DOMAIN=rh.example.com                 # Caddy obtains a certificate for this name
RH_PUBLIC_URL=https://rh.example.com
RH_SECRET_KEY=                          # 64 hex chars: remotehound gen-secret
RH_GUAC_JSON_SECRET=                    # 32 hex chars: remotehound gen-secret (also given to guacamole)

# ---- Sign-in --------------------------------------------------------------
# oauth = users pick a provider on the login page (enable one or more below).
# proxy = an authenticating reverse proxy sets identity headers (RH_PROXY_*, RH_TRUSTED_PROXIES).
# Redirect URI to register with each provider: https://<your domain>/auth/callback/<provider>
# Step-by-step per provider: docs/AUTH_PROVIDERS.md
RH_AUTH_MODE=oauth
RH_AUTH_PROVIDERS=entra                  # e.g. entra,google,apple,facebook,github,oidc
RH_BOOTSTRAP_ADMIN=you@example.com      # verified email that becomes admin on first sign-in while no admin exists

# Microsoft Entra ID (Azure AD)
RH_AUTH_ENTRA_CLIENT_ID=
RH_AUTH_ENTRA_CLIENT_SECRET=
# RH_AUTH_ENTRA_CLIENT_SECRET_FILE=
RH_AUTH_ENTRA_TENANT=                    # REQUIRED: your tenant ID (GUID); or organizations/common + ALLOWED_TENANTS
# RH_AUTH_ENTRA_ALLOWED_TENANTS=         # multi-tenant only: comma-separated tenant IDs allowed to sign in
# RH_AUTH_ENTRA_TRUST_EMAIL=true         # single tenant you control: treat directory emails as verified
# RH_AUTH_ENTRA_SCOPES=openid profile email

# Google
# RH_AUTH_GOOGLE_CLIENT_ID=
# RH_AUTH_GOOGLE_CLIENT_SECRET=
# RH_AUTH_GOOGLE_CLIENT_SECRET_FILE=
# RH_AUTH_GOOGLE_SCOPES=

# Apple (Sign in with Apple — a Services ID, a key and your team ID)
# RH_AUTH_APPLE_CLIENT_ID=               # the Services ID, e.g. com.example.remotehound
# RH_AUTH_APPLE_TEAM_ID=
# RH_AUTH_APPLE_KEY_ID=
# RH_AUTH_APPLE_PRIVATE_KEY_FILE=/run/secrets/apple_signin.p8
# RH_AUTH_APPLE_SCOPES=

# Facebook
# RH_AUTH_FACEBOOK_CLIENT_ID=
# RH_AUTH_FACEBOOK_CLIENT_SECRET=
# RH_AUTH_FACEBOOK_CLIENT_SECRET_FILE=
# RH_AUTH_FACEBOOK_SCOPES=

# GitHub
# RH_AUTH_GITHUB_CLIENT_ID=
# RH_AUTH_GITHUB_CLIENT_SECRET=
# RH_AUTH_GITHUB_CLIENT_SECRET_FILE=
# RH_AUTH_GITHUB_SCOPES=

# Any OpenID Connect issuer (Keycloak, Okta, Auth0, Authentik, …)
# RH_AUTH_OIDC_ISSUER=https://id.example.com/realms/main
# RH_AUTH_OIDC_NAME=Company SSO
# RH_AUTH_OIDC_CLIENT_ID=
# RH_AUTH_OIDC_CLIENT_SECRET=
# RH_AUTH_OIDC_CLIENT_SECRET_FILE=
# RH_AUTH_OIDC_TRUST_EMAIL=
# RH_AUTH_OIDC_SCOPES=

# ---- Optional (defaults shown) ----------------------------------------------
RH_SSH_PUBLISH=2222                      # host port devices dial (compose)
REMOTEHOUND_VERSION=latest               # image tag (compose)
# production | development. Development enables RH_AUTH_MODE=dev on loopback only.
# RH_ENV=production
# Listen address for the UI, API and Guacamole proxy (plain HTTP; put TLS in front).
# set by compose.yml: RH_HTTP_ADDR=:8080
# Internal listener for /metrics (Prometheus) and, if enabled, pprof. Never publish it.
# set by compose.yml: RH_METRICS_ADDR=127.0.0.1:9090
# Listen address of the embedded SSH tunnel server devices connect to.
# set by compose.yml: RH_SSH_ADDR=:2222
# Port devices dial (as published on the host). Initial value for the ssh_public_port setting.
# RH_SSH_PUBLIC_PORT=2222
# Address tunnel listeners bind on. In the bundle this is only reachable on the internal guac network.
# set by compose.yml: RH_TUNNEL_BIND=127.0.0.1
# Hostname guacd uses to reach tunnel listeners (the container name in the bundle).
# set by compose.yml: RH_TUNNEL_ADVERTISE_HOST=remotehound
# First port of the tunnel listener range.
# RH_TUNNEL_PORT_MIN=20000
# Last port of the tunnel listener range (inclusive).
# RH_TUNNEL_PORT_MAX=20999
# State, audit log, SSH host key and backups. Back this volume up.
# set by compose.yml: RH_DATA_DIR=/data
# Where guacd writes session recordings (mounted read-only into remotehound).
# set by compose.yml: RH_RECORDINGS_DIR=/recordings
# The same directory as guacd sees it (recording-path parameter).
# set by compose.yml: RH_GUAC_RECORDING_PATH=/recordings
# Optional JSONL file of container logs written by the vector profile; shown as source=bundle in Logs.
# set by compose.yml: RH_BUNDLE_LOG=
# File holding the OIDC client secret (Docker/K8s secret).
# RH_OIDC_CLIENT_SECRET_FILE=
# Space-separated scopes.
# RH_OIDC_SCOPES=openid profile email
# proxy mode: header carrying the authenticated user's email.
# RH_PROXY_EMAIL_HEADER=X-Forwarded-Email
# proxy mode: header carrying the display name / user.
# RH_PROXY_NAME_HEADER=X-Forwarded-User
# proxy mode: comma-separated groups (mapped through the roles_map setting).
# RH_PROXY_GROUPS_HEADER=X-Forwarded-Groups
# Comma-separated CIDRs allowed to set X-Forwarded-For and (proxy mode) identity headers, e.g. 172.18.0.0/16.
# RH_TRUSTED_PROXIES=
# proxy mode, optional: value the proxy must send in X-RemoteHound-Proxy-Secret.
# RH_PROXY_SECRET=
# proxy mode, optional: where Sign out sends the browser so the proxy's own session ends too
# (otherwise the proxy signs you straight back in), e.g. oauth2-proxy:
# RH_PROXY_LOGOUT_URL=https://sso.example.com/oauth2/sign_out?rd=https%3A%2F%2Frh.example.com%2Fsigned-out
# Optional: identity provider sign-out offered on the signed-out page (shared computers).
# RH_IDP_LOGOUT_URL=https://login.microsoftonline.com/common/oauth2/v2.0/logout
# Where Overview's "Learn more about RemoteHound" link goes (default: the project on GitHub).
# RH_PROJECT_URL=https://github.com/jchirayath/remotehound

# ---- optional container control (Services screen: start/stop/restart + container logs) ----
# Needs the rh-control helper:  docker compose --profile control up -d
# rh-control holds the Docker socket (root-equivalent) so RemoteHound never does; see docs/user/services.md.
# Same token for both (remotehound gen-secret prints one):
# RH_CONTROL_TOKEN=
# File holding RH_CONTROL_TOKEN instead.
# RH_CONTROL_TOKEN_FILE=
# Set this together with the profile; leave empty for status only:
# RH_CONTROL_URL=http://rh-control:9091
# rh-control only (set by compose.yml): RH_CONTROL_LISTEN=:9091
# rh-control only (set by compose.yml): RH_CONTROL_DOCKER_SOCKET=/var/run/docker.sock
# Group ID that owns /var/run/docker.sock on the host (stat -c %g /var/run/docker.sock).
# DOCKER_GID=999
# File holding RH_SECRET_KEY.
# RH_SECRET_KEY_FILE=
# Internal URL of the Guacamole web app.
# set by compose.yml: RH_GUAC_URL=http://guacamole:8080/guacamole
# Path under RH_PUBLIC_URL where RemoteHound proxies Guacamole. Must equal the path of RH_GUAC_URL.
# RH_GUAC_PUBLIC_PATH=/guacamole
# File holding RH_GUAC_JSON_SECRET.
# RH_GUAC_JSON_SECRET_FILE=
# guacd host:port, used by integration checks.
# set by compose.yml: RH_GUACD_ADDR=guacd:4822
# Initial log level; change it at runtime on the Debug screen.
# RH_LOG_LEVEL=INFO
# Expose net/http/pprof on RH_METRICS_ADDR. Off in production unless you are debugging.
# RH_DEBUG_PPROF=false
# Overrides the reported service.version (set by the image build).
# RH_VERSION=

# Never expose tunnel listeners on all interfaces unless firewalled
# RH_TUNNEL_BIND_ALLOW_ANY=false
