# TLS front for RemoteHound. Caddy obtains and renews the certificate for
# {$RH_DOMAIN} automatically. Security headers for the app are set by
# RemoteHound itself (scoped per path — Guacamole needs a different CSP), so
# only transport-level headers are added here.
#
# Logs never carry credentials: the Guacamole connect blob (?data=), its
# session token (?token=) and enrolment codes (/e/<code>) are live secrets for
# their lifetime, so they are masked in the access log AND in Caddy's own
# default log, which records the request when an upstream fails (502s,
# dropped websockets).
(rh_log_filter) {
	format filter {
		wrap json
		fields {
			request>uri multi_regexp {
				regexp "([?&](?:data|token)=)[^&#]*" "${1}REDACTED"
				regexp "^/e/[A-Za-z0-9]+" "/e/REDACTED"
			}
		}
	}
}

{
	log default {
		output stdout
		import rh_log_filter
	}
}

{$RH_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy remotehound:8080 {
		# Desktop sessions are long-lived WebSockets; default timeouts would cut them.
		transport http {
			read_timeout 0
			write_timeout 0
		}
		flush_interval -1
	}
	log {
		output stdout
		import rh_log_filter
	}
}
